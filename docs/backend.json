
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con roles asignados.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["admin", "moderador", "dueño", "repartidor", "cliente"],
          "description": "Define los permisos del usuario en la plataforma."
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "MainCategory": {
      "title": "MainCategory",
      "type": "object",
      "description": "Categoría global creada por el admin para agrupar tiendas.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "imageUrl"]
    },
    "Store": {
      "title": "Store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "mainCategoryId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string" },
        "isPro": { "type": "boolean", "description": "Etiqueta universal asignada por el admin." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "mainCategoryId", "name", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Perfiles de usuario y roles."
        }
      },
      {
        "path": "/mainCategories/{categoryId}",
        "definition": {
          "entityName": "MainCategory",
          "schema": { "$ref": "#/backend/entities/MainCategory" },
          "description": "Categorías globales controladas por el Admin."
        }
      }
    ]
  }
}
