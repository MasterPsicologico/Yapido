rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAdmin() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'admin';
    }

    function isRepartidor() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == 'repartidor';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn() && (get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid || isAdmin());
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn() && (get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid || isAdmin());
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      // Regla de lectura simplificada para consultas (list) y lectura individual (get)
      allow read: if isSignedIn() && (
        isAdmin() ||
        resource.data.customerId == request.auth.uid || 
        resource.data.storeOwnerId == request.auth.uid || 
        resource.data.deliveryDriverId == request.auth.uid ||
        resource.data.status == 'ready_for_pickup'
      );
      
      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        resource.data.storeOwnerId == request.auth.uid || 
        resource.data.deliveryDriverId == request.auth.uid ||
        (resource.data.status == 'ready_for_pickup' && isRepartidor()) ||
        isAdmin()
      );
      
      allow delete: if isAdmin();
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}