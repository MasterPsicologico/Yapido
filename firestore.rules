
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Regla base para perfiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // Reglas para la estructura del marketplace
    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderador'];
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'moderador']);

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // REINGENIERÍA DE ÓRDENES: Seguridad Atómica
    match /orders/{orderId} {
      // Regla de listado ultra-eficiente: Basada únicamente en datos del documento
      // Permite que la consulta se valide sin necesidad de leer perfiles externos
      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.viewers || 
        resource.data.isLogisticsPublic == true
      );
      
      // Lectura individual y creación/edición
      allow get, create, update: if isSignedIn();
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
