# ==============================================
# YAPIDO - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ==============================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env.local
# 2. Reemplaza los valores con tus keys reales
# 3. NUNCA commitear .env.local al repositorio
# ==============================================

# --- GEMINI AI (Servidor) ---
# Obtén tu API key en: https://aistudio.google.com/app/apikey
# IMPORTANTE: Restringe la clave por HTTP referer en Google Cloud Console
GEMINI_API_KEY=

# --- GOOGLE MAPS (Cliente) ---
# Obtén tu API key en: https://console.cloud.google.com/google/maps-apis/
# RESTRICCIÓN RECOMENDADA: Restringe por HTTP referer y aplica quota
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- MAPBOX (Cliente) ---
# Obtén tu token en: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=

# ==============================================
# PASARELA DE PAGOS (Configuración)
# ==============================================
# Para monetizar la app, configura una pasarela real:

# Habilitar pasarela de pagos (false = modo mock)
# PAYMENT_GATEWAY_ENABLED=true

# Tipo de pasarela: mock, mercadopago, payu, nequi, stripe
# PAYMENT_GATEWAY_TYPE=mercadopago

# Credenciales de pasarela (obtén de tu proveedor)
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_GATEWAY_URL=https://api.tupasarela.com

# ==============================================
# SEGURIDAD ADICIONAL
# ==============================================
# Clave secreta para endpoints de debug (genera una aleatoria)
# DEBUG_SECRET=tu-clave-secreta-aqui

# Secret para tareas programadas (cron jobs)
# CRON_SECRET=tu-cron-secret-aqui

# Firebase Admin (obtén de Firebase Console > Configuración del proyecto > Cuentas de servicio)
# FIREBASE_PROJECT_ID=tu-proyecto-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...