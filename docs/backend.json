
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con roles asignados.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["admin", "moderador", "dueño", "repartidor", "cliente"],
          "description": "Define los permisos del usuario en la plataforma."
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Registro de un pedido realizado por un cliente.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "preparing", "ready_for_pickup", "shipped", "delivered", "cancelled"] 
        },
        "deliveryDriverId": { "type": "string" },
        "deliveryDriverName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "storeId", "productId", "quantity", "totalPrice", "status"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Perfiles de usuario y roles."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": { "$ref": "#/backend/entities/Order" },
          "description": "Historial de pedidos para clientes, vendedores y repartidores."
        }
      }
    ]
  }
}
