rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Vitriniando Security Rules - Producción
     * 
     * Estas reglas permiten el acceso público de lectura a todas las vitrinas
     * y productos para garantizar el descubrimiento inmediato.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Reglas de Colecciones ---

    /** Usuarios: Privados */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if isOwner(userId);
    }

    /** 
     * Tiendas: Lectura pública total para evitar errores 404.
     * Escritura restringida al dueño.
     */
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isSignedIn() && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;

        match /products/{productId} {
          allow read: if true;
          allow write: if isSignedIn() && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
        }
      }
    }

    /** Productos Globales: Lectura pública */
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.data.storeOwnerId == request.auth.uid;
    }
  }
}