# =============================================================================
# Yapido Movilidad — variables de entorno
# Copia este archivo a .env.local y completa los valores.
# =============================================================================

# --- Firebase cliente (públicas) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=yapido-movilidad
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://yapido-movilidad-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=yapido-movilidad.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Backend ---
NEXT_PUBLIC_API_BASE=https://us-central1-yapido-movilidad.cloudfunctions.net
NEXT_PUBLIC_API_TIMEOUT_MS=12000

# --- Pagos (Wompi Colombia) ---
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
NEXT_PUBLIC_WOMPI_SANDBOX=true

# --- App ---
NEXT_PUBLIC_APP_NAME=Yapido
NEXT_PUBLIC_DEFAULT_CITY_ID=aguachica
NEXT_PUBLIC_LOCALE=es-CO
NEXT_PUBLIC_TIMEZONE=America/Bogota
NEXT_PUBLIC_CURRENCY=COP

# --- Feature flags ---
NEXT_PUBLIC_FEATURE_SURGE=false
NEXT_PUBLIC_FEATURE_TIPS=true
NEXT_PUBLIC_FEATURE_OFFLINE_MAPS=true
NEXT_PUBLIC_FEATURE_BACKGROUND_GPS=true

# --- Server-only (NO_PREFIX = no expuesto al cliente) ---
# Wompi privado (para reconciliación server-side)
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
