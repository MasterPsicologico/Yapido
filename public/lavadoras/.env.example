# ==============================================
# LAVADORAS - VARIABLES DE ENTORNO
# ==============================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env.local
#   2. Rellena los valores
#   3. NUNCA commitear .env.local (.gitignore lo bloquea)
# ==============================================

# --- IA (Gemini / Genkit) ---
# https://aistudio.google.com/app/apikey — restringir por HTTP referer
GEMINI_API_KEY=

# --- Google Maps (cliente) ---
# https://console.cloud.google.com/google/maps-apis/
# Restringir por HTTP referer + quota
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Mapbox (cliente) ---
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Nequi (pagos Colombia) ---
NEQUI_API_KEY=
NEQUI_CLIENT_ID=
NEQUI_CLIENT_SECRET=
NEQUI_WEBHOOK_SECRET=

# --- Universal Links / Deep Linking ---
# URL pública del subdominio lavadoras
NEXT_PUBLIC_APP_URL=https://lavadoras.yapido.click

# --- Seguridad ---
# Genera uno aleatorio: `openssl rand -hex 32`
DEBUG_SECRET=
CRON_SECRET=

# --- Firebase Admin (server-only, NUNCA exponer al cliente) ---
FIREBASE_PROJECT_ID=studio-4796645076-6f375
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@studio-4796645076-6f375.iam.gserviceaccount.com
# La clave va con \n literales (se reemplazan en runtime)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- Capacitor (APK nativa) ---
# Versión de la app emparejada con capacitor.config.ts
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Flags ---
# false = modo mock sin pasarela real
PAYMENT_GATEWAY_ENABLED=false
