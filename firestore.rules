
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      // Regla de lectura unificada y robusta para evitar errores de listado
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.get('participants', []) ||
        resource.data.get('isLogisticsPublic', false) == true ||
        request.auth.uid == resource.data.get('storeOwnerId', '') ||
        request.auth.uid == resource.data.get('customerId', '') ||
        request.auth.uid == resource.data.get('deliveryDriverId', '') ||
        isAdmin()
      );

      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.get('participants', []) ||
        isAdmin() ||
        resource.data.get('isLogisticsPublic', false) == true ||
        request.auth.uid == resource.data.get('storeOwnerId', '')
      );
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.get('storeOwnerId', '') || 
        request.auth.uid == resource.data.get('customerId', '')
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /incidents/{incidentId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
