
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con roles asignados y contacto.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string", "description": "Número de WhatsApp del usuario para contacto." },
        "role": { 
          "type": "string", 
          "enum": ["admin", "moderador", "dueño", "repartidor", "cliente"],
          "description": "Define los permisos del usuario en la plataforma."
        },
        "favoriteStores": { "type": "array", "items": { "type": "string" } },
        "favoriteProducts": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Registro de un pedido realizado por un cliente.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "storeOwnerId": { "type": "string" },
        "storeAddress": { "type": "string" },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" },
              "imageUrl": { "type": "string" }
            }
          } 
        },
        "productName": { "type": "string" },
        "quantity": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "preparing", "ready_for_pickup", "at_store", "delivered_to_driver", "shipped", "delivered", "cancelled"] 
        },
        "rating": { "type": "number", "minimum": 1, "maximum": 5 },
        "review": { "type": "string" },
        "ratedAt": { "type": "string", "format": "date-time" },
        "deliveryDriverId": { "type": "string" },
        "deliveryDriverName": { "type": "string" },
        "deliveryCode": { "type": "string" },
        "isLogisticsPublic": { "type": "boolean" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "storeId", "status", "participants"]
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "description": "Mensaje individual dentro del chat de un pedido.",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "senderName", "type", "createdAt"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Perfiles de usuario."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": { "$ref": "#/backend/entities/Order" },
          "description": "Pedidos principales."
        }
      },
      {
        "path": "/orders/{orderId}/messages/{messageId}",
        "definition": {
          "entityName": "Message",
          "schema": { "$ref": "#/backend/entities/Message" },
          "description": "Chat interno del pedido."
        }
      }
    ]
  }
}
