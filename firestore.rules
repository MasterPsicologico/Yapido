
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ARQUITECTURA DE ÓRDENES: Seguridad Segmentada
    match /orders/{orderId} {
      // Lectura individual (get)
      allow get: if isSignedIn() && (
        request.auth.uid in resource.data.get('participants', []) || 
        resource.data.get('isLogisticsPublic', false) == true ||
        resource.data.get('deliveryDriverId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('storeOwnerId', '') == request.auth.uid
      );

      // Reglas de Listado (list): Segmentadas para optimización del analizador de consultas
      // Rama 1: El usuario es participante directo
      allow list: if isSignedIn() && (request.auth.uid in resource.data.get('participants', []));
      // Rama 2: La ruta es pública para logística
      allow list: if isSignedIn() && (resource.data.get('isLogisticsPublic', false) == true);
      // Rama 3: El usuario tiene un rol específico asignado
      allow list: if isSignedIn() && (
        resource.data.get('deliveryDriverId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('storeOwnerId', '') == request.auth.uid
      );

      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        (request.auth.uid in resource.data.get('participants', [])) ||
        (resource.data.get('isLogisticsPublic', false) == true)
      );
      
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.get('storeOwnerId', '') || 
        request.auth.uid == resource.data.get('customerId', '')
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.get('participants', []);
      }
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
