{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con roles asignados y contacto.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": ["admin", "moderador", "dueño", "repartidor", "cliente"]
        },
        "balance": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Registro de un pedido o solicitud de alquiler.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "storeId": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["pending", "preparing", "ready_for_pickup", "at_store", "delivered_to_driver", "shipped", "delivered", "cancelled"] 
        },
        "totalPrice": { "type": "number" },
        "washerType": { "type": "string" },
        "isLogisticsPublic": { "type": "boolean" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "status", "participants"]
    },
    "Offer": {
      "title": "Offer",
      "type": "object",
      "description": "Propuesta de precio para un alquiler de lavadora.",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "driverId": { "type": "string" },
        "price": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storeId", "driverId", "price"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Perfiles."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": { "$ref": "#/backend/entities/Order" },
          "description": "Pedidos."
        }
      },
      {
        "path": "/orders/{orderId}/offers/{offerId}",
        "definition": {
          "entityName": "Offer",
          "schema": { "$ref": "#/backend/entities/Offer" },
          "description": "Contraofertas."
        }
      }
    ]
  }
}