
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      function isParticipant() {
        return request.auth.uid in resource.data.get('participants', []);
      }

      allow get: if isSignedIn() && (
        isParticipant() || 
        resource.data.get('isLogisticsPublic', false) == true ||
        resource.data.get('deliveryDriverId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('storeOwnerId', '') == request.auth.uid
      );

      allow list: if isSignedIn() && (
        request.auth.uid in resource.data.get('participants', []) ||
        resource.data.get('isLogisticsPublic', false) == true ||
        resource.data.get('deliveryDriverId', '') == request.auth.uid ||
        resource.data.get('customerId', '') == request.auth.uid ||
        resource.data.get('storeOwnerId', '') == request.auth.uid
      );

      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        isParticipant() ||
        resource.data.get('isLogisticsPublic', false) == true
      );
      
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.get('storeOwnerId', '') || 
        request.auth.uid == resource.data.get('customerId', '')
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.get('participants', []);
      }
    }

    match /incidents/{incidentId} {
      // Regla para el Agente de Soporte: Permitir registro de incidentes y lectura para auditoría
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if false; // Los registros de incidentes son inmutables
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
