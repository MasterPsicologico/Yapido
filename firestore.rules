rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ARQUITECTURA DE ÓRDENES: Seguridad Unificada y Multi-Rol
    match /orders/{orderId} {
      allow list: if isSignedIn() && (
        (request.auth.uid in resource.data.get('participants', [])) || 
        (resource.data.get('isLogisticsPublic', false) == true) ||
        (resource.data.get('deliveryDriverId', '') == request.auth.uid) ||
        (resource.data.get('customerId', '') == request.auth.uid) ||
        (resource.data.get('storeOwnerId', '') == request.auth.uid)
      );

      allow get: if isSignedIn() && (
        (request.auth.uid in resource.data.get('participants', [])) || 
        (resource.data.get('isLogisticsPublic', false) == true) ||
        (resource.data.get('deliveryDriverId', '') == request.auth.uid) ||
        (resource.data.get('customerId', '') == request.auth.uid) ||
        (resource.data.get('storeOwnerId', '') == request.auth.uid)
      );

      allow create: if isSignedIn();
      
      allow update: if isSignedIn();
      
      allow delete: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}