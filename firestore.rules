rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasMinLength(str, min) {
      return str is string && str.size() >= min;
    }

    function hasMaxLength(str, max) {
      return str is string && str.size() <= max;
    }

    function isValidPrice(price) {
      return price is number && price >= 0 && price <= 10000000;
    }

    function isValidLatLng(lat, lng) {
      return lat is number && lng is number && 
             lat >= -90 && lat <= 90 && 
             lng >= -180 && lng <= 180;
    }

    function isValidCoordinate(lat, lng) {
      return lat != null && lng != null && isValidLatLng(lat, lng);
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/appConfig/superAdmins).data.adminIds[request.auth.uid] == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        isSuperAdmin() || 
        getUserData().role == 'admin'
      );
    }

    function isOwner() {
      return isSignedIn() && (
        isAdmin() || 
        getUserData().role == 'dueño'
      );
    }

    function isRepartidor() {
      return isSignedIn() && (
        getUserData().role == 'repartidor' || 
        isAdmin()
      );
    }

    function isAuthenticatedUserOrAdmin(userId) {
      return isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    function canAccessOrderData(orderData) {
      return request.auth.uid == orderData.customerId ||
             request.auth.uid == orderData.storeOwnerId ||
             ('assignedDriverId' in orderData && request.auth.uid in orderData.assignedDriverId) ||
             ('participants' in orderData && request.auth.uid in orderData.participants) ||
             isAdmin() ||
             (isRepartidor() && (
               orderData.get('isLogisticsPublic', false) == true ||
               orderData.get('storeId', '') == getUserData().get('linkedStoreId', 'NO_STORE')
             ));
    }

    function canAccessOrder(orderId) {
      return canAccessOrderData(get(/databases/$(database)/documents/orders/$(orderId)).data);
    }

    function isValidOrderData() {
      let data = request.resource.data;
      return data.get('totalPrice', 0) <= 10000000 &&
             data.get('totalPrice', 0) >= 0;
    }

    match /appConfig/superAdmins {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['email', 'role']);
      
      allow update: if isAuthenticatedUserOrAdmin(userId);
      allow delete: if isAdmin();
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['name', 'ownerId']) &&
        request.resource.data.ownerId == request.auth.uid;
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.ownerId
      );
      
      allow delete: if isAdmin();

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn() && (
          isAdmin() ||
          request.auth.uid == get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId
        );
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn() && (
            isAdmin() ||
            request.auth.uid == get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId
          );
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        request.resource.data.keys().hasAll(['name', 'price', 'storeId']);
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.storeOwnerId
      );
      allow delete: if isAdmin() || 
        (isSignedIn() && request.auth.uid == resource.data.storeOwnerId);
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && canAccessOrderData(resource.data);

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['customerId', 'storeId', 'totalPrice']) &&
        request.resource.data.customerId == request.auth.uid &&
        isValidPrice(request.resource.data.totalPrice);

      allow update: if isSignedIn() && (
        isAdmin() ||
        (canAccessOrderData(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'eta', 'driverLocation'])) ||
        (request.auth.uid == resource.data.customerId && request.resource.data.status in ['pending', 'confirmed'])
      );
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.storeOwnerId ||
        (request.auth.uid == resource.data.customerId && resource.data.status == 'pending')
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && canAccessOrder(orderId);
      }

      match /offers/{offerId} {
        allow read: if isSignedIn() && canAccessOrder(orderId);
        allow create: if isSignedIn() && isRepartidor();
      }
    }

    match /machines/{machineId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        request.resource.data.ownerId == request.auth.uid
      );
      allow update, delete: if isAdmin() || 
        (isSignedIn() && request.auth.uid == resource.data.ownerId);
    }

    match /incidents/{incidentId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.userId
      );
      allow update, delete: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /zones/{zoneId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /driverLocations/{locationId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        isRepartidor() ||
        request.auth.uid == locationId
      );
      allow write: if isSignedIn() && request.auth.uid == locationId;
    }

    match /fleetMetrics/{driverId} {
      allow read: if isAdmin() || request.auth.uid == driverId;
      allow write: if isAdmin();
    }

    match /geographicData/{geoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}