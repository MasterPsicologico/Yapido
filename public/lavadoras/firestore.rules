rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidPrice(price) {
      return price is number && price >= 0 && price <= 10000000;
    }

    function isValidLatLng(lat, lng) {
      return lat is number && lng is number &&
             lat >= -90 && lat <= 90 &&
             lng >= -180 && lng <= 180;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/appConfig/superAdmins).data.adminIds[request.auth.uid] == true;
    }

    function isAdmin() {
      return isSignedIn() && (isSuperAdmin() || getUserData().role == 'admin');
    }

    function isRepartidor() {
      return isSignedIn() && (getUserData().role == 'repartidor' || isAdmin());
    }

    function canAccessRental(rentalData) {
      return request.auth.uid == rentalData.customerId ||
             request.auth.uid == rentalData.driverId ||
             isAdmin() ||
             (isRepartidor() && rentalData.get('status', '') in ['waiting', 'assigned', 'in_transit', 'returning']);
    }

    match /appConfig/superAdmins {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['email', 'role']);
      allow update: if isSignedIn() &&
        (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ============ LAVADORAS — entidades específicas ============

    match /washerRentals/{rentalId} {
      allow read: if isSignedIn() && canAccessRental(resource.data);
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['customerId', 'washerType', 'hours', 'status', 'pricing', 'address', 'cityId']) &&
        request.resource.data.customerId == request.auth.uid &&
        isValidPrice(request.resource.data.pricing.totalPrice);
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.customerId ||
        (canAccessRental(resource.data) &&
         request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'driverId', 'updatedAt']))
      );
      allow delete: if isAdmin() ||
        (request.auth.uid == resource.data.customerId && resource.data.status == 'waiting');

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && canAccessRental(get(/databases/$(database)/documents/washerRentals/$(rentalId)).data);
      }
    }

    match /washerInventory/{unitId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /washerPricing/{pricingId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // ============ Catálogo compartido (lectura pública) ============

    match /products/{productId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['name', 'price', 'storeId']) &&
        isValidPrice(request.resource.data.price);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['name', 'ownerId']) &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.ownerId);
      allow delete: if isAdmin();
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
      match /zones/{zoneId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ============ Componentes compartidos con el ecosistema ============

    match /driverProfiles/{uid} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == uid || isRepartidor());
      allow write: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /fleetMissions/{missionId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.driverId ||
        resource.data.rentalId in get(/databases/$(database)/documents/users/$(request.auth.uid)/data).get('rentals', []).asList()
      );
      allow create: if isAdmin() || isRepartidor();
      allow update: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.driverId);
      allow delete: if isAdmin();
    }

    match /fleetVehicles/{vehicleId} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.ownerDriverId);
      allow write: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.ownerDriverId);
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.uid ||
        (resource.data.rentalId != null &&
         get(/databases/$(database)/documents/washerRentals/$(resource.data.rentalId)).data.customerId == request.auth.uid)
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == resource.data.driverUid);
      allow write: if isAdmin();
    }

    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.raterUid == request.auth.uid &&
        request.resource.data.score is number &&
        request.resource.data.score >= 1 && request.resource.data.score <= 5;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.uid;
      allow write: if isAdmin() || request.auth.uid == resource.data.uid;
    }
  }
}
