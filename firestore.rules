rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isRepartidor() {
      return isSignedIn() && (getUserData().role == 'repartidor' || getUserData().role == 'admin');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      // REGLA DE LECTURA MAESTRA: 
      // Permite leer si: es admin, es participante, es el dueño de la tienda, es el cliente,
      // la orden es pública logísticamente, o es el repartidor vinculado a la tienda de la orden.
      allow read: if (isSignedIn() && (
        isAdmin() ||
        request.auth.uid in resource.data.get('participants', []) ||
        request.auth.uid == resource.data.get('storeOwnerId', '') ||
        request.auth.uid == resource.data.get('customerId', '') ||
        (getUserData().role == 'repartidor' && resource.data.get('storeId', '') == getUserData().get('linkedStoreId', 'NONE'))
      )) || (resource.data.get('isLogisticsPublic', false) == true);

      allow create: if isSignedIn();
      
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid in resource.data.get('participants', []) ||
        resource.data.get('isLogisticsPublic', false) == true ||
        request.auth.uid == resource.data.get('storeOwnerId', '') ||
        (isRepartidor() && resource.data.status in ['pending', 'preparing', 'ready_for_pickup', 'at_store', 'shipped', 'delivered_to_driver'])
      );
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.get('storeOwnerId', '') || 
        request.auth.uid == resource.data.get('customerId', '')
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.get('participants', [])
        );
      }

      match /offers/{offerId} {
        // Solo el cliente y el dueño de la tienda pueden ver las ofertas de una orden específica
        allow read: if isSignedIn() && (
          isAdmin() ||
          request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.customerId ||
          request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.storeOwnerId
        );
        // Cualquier usuario registrado puede proponer una contraoferta
        allow create: if isSignedIn();
      }
    }

    match /incidents/{incidentId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}