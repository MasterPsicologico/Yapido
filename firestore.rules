
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ARQUITECTURA DE ÓRDENES: Seguridad Unificada y Multi-Rol
    // Optimizada para permitir listados basados en roles específicos o participación general
    match /orders/{orderId} {
      allow list: if isSignedIn() && (
        (request.auth.uid in resource.data.get('participants', [])) || 
        (resource.data.get('isLogisticsPublic', false) == true) ||
        (resource.data.get('deliveryDriverId', '') == request.auth.uid) ||
        (resource.data.get('customerId', '') == request.auth.uid) ||
        (resource.data.get('storeOwnerId', '') == request.auth.uid)
      );

      allow get: if isSignedIn() && (
        (request.auth.uid in resource.data.get('participants', [])) || 
        (resource.data.get('isLogisticsPublic', false) == true) ||
        (resource.data.get('deliveryDriverId', '') == request.auth.uid) ||
        (resource.data.get('customerId', '') == request.auth.uid) ||
        (resource.data.get('storeOwnerId', '') == request.auth.uid)
      );

      allow create: if isSignedIn();
      
      // Permitir actualización si el usuario es participante o es un repartidor aceptando una ruta pública
      allow update: if isSignedIn() && (
        (request.auth.uid in resource.data.get('participants', [])) ||
        (resource.data.get('isLogisticsPublic', false) == true)
      );
      
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.get('storeOwnerId', '') || 
        request.auth.uid == resource.data.get('customerId', '')
      );

      match /messages/{messageId} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.get('participants', []);
      }
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
