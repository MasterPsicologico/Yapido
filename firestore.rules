
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn(); // Simplificado para que el usuario pueda probar el rol de admin
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
