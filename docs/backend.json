
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil de usuario con roles asignados y contacto.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string", "description": "Número de WhatsApp del usuario para contacto." },
        "role": { 
          "type": "string", 
          "enum": ["admin", "moderador", "dueño", "repartidor", "cliente"],
          "description": "Define los permisos del usuario en la plataforma."
        },
        "favoriteStores": { "type": "array", "items": { "type": "string" } },
        "favoriteProducts": { "type": "array", "items": { "type": "string" } },
        "balance": { "type": "number", "description": "Saldo actual del repartidor (puede ser negativo por deudas)." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "Registro de un pedido realizado por un cliente.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "storeOwnerId": { "type": "string" },
        "storeAddress": { "type": "string" },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" },
              "imageUrl": { "type": "string" }
            }
          } 
        },
        "productName": { "type": "string" },
        "totalPrice": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["cash", "digital"] },
        "status": { 
          "type": "string", 
          "enum": ["pending", "preparing", "ready_for_pickup", "at_store", "delivered_to_driver", "shipped", "delivered", "cancelled"] 
        },
        "deliveryDriverId": { "type": "string" },
        "deliveryDriverName": { "type": "string" },
        "deliveryCode": { "type": "string" },
        "isLogisticsPublic": { "type": "boolean" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "storeId", "status", "participants"]
    },
    "Incident": {
      "title": "Incident",
      "type": "object",
      "description": "Registros de incidentes operativos para el Agente de Soporte.",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "driverId": { "type": "string" },
        "reason": { "type": "string" },
        "hasProducts": { "type": "boolean" },
        "orderValue": { "type": "number" },
        "type": { "type": "string" },
        "agentOwner": { "type": "string", "enum": ["soporte"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderId", "driverId", "reason", "type", "agentOwner"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Perfiles de usuario."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": { "$ref": "#/backend/entities/Order" },
          "description": "Pedidos principales."
        }
      },
      {
        "path": "/incidents/{incidentId}",
        "definition": {
          "entityName": "Incident",
          "schema": { "$ref": "#/backend/entities/Incident" },
          "description": "Logs de incidentes operativos."
        }
      }
    ]
  }
}
