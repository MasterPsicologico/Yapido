
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return request.auth.uid in ['9qjHXRHfKfS2LrlE6074rR9JOm83', 'OUeZfonX8AY4YHRI4qLCc1WiVFN2', 'YohYZ5BLFiUIL9Z4IWrTVlDjwt43', 'ZfSO1go6agR2owAsDh07GH440QN2'];
    }

    function isAdmin() {
      return isSignedIn() && (isSuperAdmin() || getUserData().role == 'admin');
    }

    function isRepartidor() {
      return isSignedIn() && (getUserData().role == 'repartidor' || getUserData().role == 'admin');
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /mainCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stores/{storeId} {
      allow read: if true;
      // Crear: cualquier usuario autenticado puede registrar un negocio
      allow create: if isSignedIn();
      // Actualizar: el dueño de la tienda o un admin puede modificarla
      // (incluye el soft-delete: cambiar status a 'trashed')
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.ownerId
      );
      // Eliminar permanentemente: solo admin o el sistema (via Firebase Admin SDK)
      allow delete: if isAdmin();

      match /categories/{catId} {
        allow read: if true;
        allow write: if isSignedIn();
        
        match /products/{prodId} {
          allow read: if true;
          allow write: if isSignedIn();
        }
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /orders/{orderId} {
      // Lectura: los usuarios autenticados pueden leer todos los pedidos (Bolsa, Rutas),
      // y los pedidos también son legibles públicamente para el tracking del cliente.
      allow read: if true;

      // Los clientes públicos pueden crear pedidos sin autenticarse.
      // Los usuarios autenticados también pueden crear pedidos.
      allow create: if true;
      
      // Permitir actualización pública para que clientes no autenticados
      // puedan aceptar/rechazar ofertas de ETA.
      // Los usuarios autenticados (dueños, repartidores, admins) también pueden actualizar.
      allow update: if true;
      
      allow delete: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.get('storeOwnerId', '') || 
        request.auth.uid == resource.data.get('customerId', '')
      );

      match /messages/{messageId} {
        // Permitir leer/escribir mensajes si:
        // 1. Es Admin
        // 2. Es un participante registrado del chat
        // 3. Es un repartidor y la orden es pública (Chat anticipado)
        allow read, write: if isSignedIn() && (
          isAdmin() ||
          request.auth.uid in get(/databases/$(database)/documents/orders/$(orderId)).data.get('participants', []) ||
          (isRepartidor() && get(/databases/$(database)/documents/orders/$(orderId)).data.get('isLogisticsPublic', false) == true)
        );
      }

      match /offers/{offerId} {
        // Permitir leer ofertas si eres el dueño del pedido o el repartidor vinculado
        allow read: if isSignedIn() && (
          isAdmin() ||
          request.auth.uid == get(/databases/$(database)/documents/orders/$(orderId)).data.customerId ||
          (getUserData().role == 'repartidor' && get(/databases/$(database)/documents/orders/$(orderId)).data.get('storeId', '') == getUserData().get('linkedStoreId', 'NONE'))
        );
        allow create: if isSignedIn();
      }
    }

    // Fase 7: Inventario de Lavadoras (Machines)
    match /machines/{machineId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /incidents/{incidentId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Colección de Ciudades Operativas (Sistema Geográfico)
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /zones/{zoneId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
