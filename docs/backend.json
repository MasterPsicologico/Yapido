
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the Vitriniando application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "MainCategory": {
      "title": "MainCategory",
      "type": "object",
      "description": "Categoría global creada por el admin para agrupar tiendas.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "imageUrl"]
    },
    "Store": {
      "title": "Store",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "mainCategoryId": { "type": "string", "description": "ID de la categoría principal a la que pertenece." },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "address": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "mainCategoryId", "name", "status"]
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "imageUrl": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "storeId", "name", "price"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/mainCategories/{categoryId}",
        "definition": {
          "entityName": "MainCategory",
          "schema": { "$ref": "#/backend/entities/MainCategory" },
          "description": "Categorías globales del marketplace."
        }
      },
      {
        "path": "/stores/{storeId}",
        "definition": {
          "entityName": "Store",
          "schema": { "$ref": "#/backend/entities/Store" },
          "description": "Tiendas registradas."
        }
      }
    ]
  }
}
