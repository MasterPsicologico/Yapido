{
  "project": {
    "name": "lavadoras",
    "description": "App standalone Next.js para alquiler de lavadoras con logística propia, IA y APK Android. Conserva el modelo de datos compartido con Yapido pero añade entidades específicas del dominio WasherRental.",
    "firebaseProject": "studio-4796645076-6f375",
    "authDomain": "auth.yapido.click"
  },
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Perfil base compartido con todo el ecosistema (Yapido/Finanzas/Nimbus). Para lavadoras, los roles relevantes son: cliente, repapartidor, admin.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["admin", "repartidor", "cliente"]
        },
        "fcmTokens": { "type": "array", "items": { "type": "string" } },
        "locale": { "type": "string", "default": "es-CO" },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"], "default": "active" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role"]
    },
    "WasherRental": {
      "title": "WasherRental",
      "type": "object",
      "description": "Reserva de alquiler de lavadora. Es la entidad central de este producto.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string", "description": "UID del cliente que reserva." },
        "washerType": {
          "type": "string",
          "enum": ["standard", "premium", "industrial"],
          "description": "Tipo de lavadora alquilada."
        },
        "modelId": { "type": "string", "description": "Modelo concreto del inventario (WasherInventory.id)." },
        "hours": { "type": "integer", "minimum": 4, "maximum": 24 },
        "address": { "type": "string" },
        "cityId": { "type": "string" },
        "zoneId": { "type": "string" },
        "coordinates": {
          "type": "object",
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          },
          "required": ["lat", "lng"]
        },
        "scheduledFor": { "type": "string", "format": "date-time", "description": "Inicio programado de la entrega." },
        "status": {
          "type": "string",
          "enum": [
            "waiting",
            "assigned",
            "in_transit",
            "delivered",
            "in_use",
            "returning",
            "returned",
            "cancelled"
          ]
        },
        "pricing": {
          "type": "object",
          "properties": {
            "currency": { "type": "string", "default": "COP" },
            "rentalFee": { "type": "number" },
            "logisticsFee": { "type": "number" },
            "serviceFee": { "type": "number" },
            "totalPrice": { "type": "number" },
            "pricingBreakdownId": { "type": "string", "description": "ID del cálculo del agente precios." }
          },
          "required": ["totalPrice", "currency"]
        },
        "paymentId": { "type": "string" },
        "driverId": { "type": "string", "description": "UID del repartidor asignado (si status >= assigned)." },
        "pickupMissionId": { "type": "string" },
        "returnMissionId": { "type": "string" },
        "ratingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "customerId", "washerType", "hours", "status", "pricing", "address", "cityId"]
    },
    "WasherInventory": {
      "title": "WasherInventory",
      "type": "object",
      "description": "Unidad física de lavadora en posesión de la operación.",
      "properties": {
        "id": { "type": "string" },
        "serialNumber": { "type": "string" },
        "type": { "type": "string", "enum": ["standard", "premium", "industrial"] },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "capacityKg": { "type": "number" },
        "purchaseDate": { "type": "string", "format": "date-time" },
        "lastMaintenanceAt": { "type": "string", "format": "date-time" },
        "nextMaintenanceDueAt": { "type": "string", "format": "date-time" },
        "status": {
          "type": "string",
          "enum": ["available", "in_transit", "in_use", "maintenance", "lost"],
          "default": "available"
        },
        "currentCityId": { "type": "string" },
        "currentLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "ts": { "type": "integer" }
          }
        },
        "totalRentals": { "type": "integer", "default": 0 },
        "totalRevenue": { "type": "number", "default": 0 },
        "iotSensorId": { "type": "string", "description": "ID de sensor IoT si la unidad está instrumentada." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "serialNumber", "type", "status"]
    },
    "WasherPricing": {
      "title": "WasherPricing",
      "type": "object",
      "description": "Cotización persistida del agente `precios`. Permite auditar y reconstruir tarifas sin recalcular.",
      "properties": {
        "id": { "type": "string" },
        "washerType": { "type": "string", "enum": ["standard", "premium", "industrial"] },
        "hours": { "type": "integer" },
        "cityId": { "type": "string" },
        "zoneId": { "type": "string" },
        "rentalFee": { "type": "number" },
        "logisticsFee": { "type": "number" },
        "serviceFee": { "type": "number" },
        "totalPrice": { "type": "number" },
        "currency": { "type": "string", "default": "COP" },
        "factors": {
          "type": "object",
          "description": "Inputs que justifican la tarifa.",
          "properties": {
            "demandMultiplier": { "type": "number" },
            "distanceKm": { "type": "number" },
            "isWeekend": { "type": "boolean" },
            "isHoliday": { "type": "boolean" }
          }
        },
        "generatedByAgent": { "type": "string", "description": "ID de versión del agente precios." },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "washerType", "hours", "totalPrice", "currency"]
    },
    "DriverProfile": {
      "title": "DriverProfile",
      "type": "object",
      "description": "Perfil del repartidor. Compartido con Yapido padre (misma colección).",
      "properties": {
        "uid": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "blocked", "recycled"] },
        "vehicleType": { "type": "string", "enum": ["moto", "bici", "auto", "auto_carga"] },
        "vehiclePlate": { "type": "string" },
        "cityId": { "type": "string" },
        "ratingAvg": { "type": "number", "minimum": 0, "maximum": 5 },
        "ratingCount": { "type": "integer" },
        "totalMissions": { "type": "integer" },
        "earnings": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "currentLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "heading": { "type": "number" },
            "speed": { "type": "number" },
            "ts": { "type": "integer" }
          }
        },
        "verificationCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "status"]
    },
    "FleetMission": {
      "title": "FleetMission",
      "type": "object",
      "description": "Misión logística. Para lavadoras los tipos relevantes son washer_pickup y washer_delivery.",
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["delivery", "washer_pickup", "washer_delivery", "pickup"]
        },
        "rentalId": { "type": "string", "description": "Referencia a WasherRental.id." },
        "washerInventoryId": { "type": "string", "description": "Unidad concreta transportada." },
        "driverId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["assigned", "accepted", "en_route_pickup", "at_pickup", "in_transit", "at_destination", "completed", "cancelled"]
        },
        "pickup": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "dropoff": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "fare": { "type": "number" },
        "qrToken": { "type": "string", "description": "Token QR escaneado en entrega/devolución." },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "driverId", "status"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "description": "Pago asociado a una WasherRental. Soporta Nequi, PSE, PayU, Stripe.",
      "properties": {
        "id": { "type": "string" },
        "rentalId": { "type": "string" },
        "uid": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "default": "COP" },
        "method": { "type": "string", "enum": ["nequi", "pse", "cash", "payu", "stripe"] },
        "provider": { "type": "string" },
        "providerRef": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "paid", "failed", "refunded"] },
        "txId": { "type": "string" },
        "paidAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "rentalId", "amount", "status"]
    },
    "Rating": {
      "title": "Rating",
      "type": "object",
      "description": "Calificación registrada al completar la WasherRental.",
      "properties": {
        "id": { "type": "string" },
        "rentalId": { "type": "string" },
        "raterUid": { "type": "string" },
        "targetUid": { "type": "string" },
        "targetType": { "type": "string", "enum": ["driver", "washer_unit"] },
        "score": { "type": "number", "minimum": 1, "maximum": 5 },
        "comment": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "rentalId", "score"]
    },
    "City": {
      "title": "City",
      "type": "object",
      "description": "Ciudad operativa con geofence y serviceArea.",
      "properties": {
        "cityId": { "type": "string" },
        "displayName": { "type": "string" },
        "region": { "type": "string" },
        "country": { "type": "string", "default": "CO" },
        "currency": { "type": "string", "default": "COP" },
        "timezone": { "type": "string", "default": "America/Bogota" },
        "geofence": { "type": "array", "description": "Polígono GeoJSON [[lng,lat],...]" },
        "serviceArea": { "type": "array", "description": "Polígono GeoJSON del área operativa." },
        "centerLat": { "type": "number" },
        "centerLng": { "type": "number" },
        "population": { "type": "integer" },
        "status": { "type": "string", "enum": ["active", "launching", "paused"] },
        "supportPhone": { "type": "string" },
        "supportWhatsapp": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["cityId", "displayName"]
    },
    "Zone": {
      "title": "Zone",
      "type": "object",
      "description": "Zona dentro de una ciudad (sector, barrio).",
      "properties": {
        "id": { "type": "string" },
        "cityId": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "polygon": { "type": "array" },
        "centerLat": { "type": "number" },
        "centerLng": { "type": "number" },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "cityId", "name"]
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "description": "Notificación in-app para el usuario (además de FCM push).",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["rental", "mission", "payment", "rating", "system", "promo"]
        },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "data": { "type": "object" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "uid", "type", "title"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "type": "object",
      "description": "Configuración global. Documento único: appConfig.",
      "properties": {
        "id": { "type": "string", "default": "appConfig" },
        "superAdmins": { "type": "object", "properties": { "adminIds": { "type": "object", "additionalProperties": { "type": "boolean" } } } },
        "paymentGateway": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "provider": { "type": "string", "enum": ["nequi", "pse", "payu", "stripe"] },
            "publicKey": { "type": "string" }
          }
        },
        "washerTypes": {
          "type": "array",
          "description": "Tipos de lavadora habilitados y su tarifa base por hora.",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["standard", "premium", "industrial"] },
              "baseHourlyRate": { "type": "number" },
              "enabled": { "type": "boolean" }
            }
          }
        },
        "maintenance": { "type": "boolean" },
        "cronSecret": { "type": "string" },
        "debugSecret": { "type": "string" }
      },
      "required": ["id"]
    }
  },
  "auth": {
    "providers": ["google.com", "phone", "password"],
    "note": "El provider activo en APK es google.com vía @capacitor-firebase/authentication."
  },
  "firestore": {
    "structure": [
      { "path": "/users/{userId}", "definition": { "entityName": "User", "schema": { "$ref": "#/entities/User" } } },
      { "path": "/washerRentals/{rentalId}", "definition": { "entityName": "WasherRental", "schema": { "$ref": "#/entities/WasherRental" } } },
      { "path": "/washerInventory/{unitId}", "definition": { "entityName": "WasherInventory", "schema": { "$ref": "#/entities/WasherInventory" } } },
      { "path": "/washerPricing/{pricingId}", "definition": { "entityName": "WasherPricing", "schema": { "$ref": "#/entities/WasherPricing" } } },
      { "path": "/driverProfiles/{uid}", "definition": { "entityName": "DriverProfile", "schema": { "$ref": "#/entities/DriverProfile" } } },
      { "path": "/fleetMissions/{missionId}", "definition": { "entityName": "FleetMission", "schema": { "$ref": "#/entities/FleetMission" } } },
      { "path": "/payments/{paymentId}", "definition": { "entityName": "Payment", "schema": { "$ref": "#/entities/Payment" } } },
      { "path": "/ratings/{ratingId}", "definition": { "entityName": "Rating", "schema": { "$ref": "#/entities/Rating" } } },
      { "path": "/cities/{cityId}", "definition": { "entityName": "City", "schema": { "$ref": "#/entities/City" } } },
      { "path": "/zones/{zoneId}", "definition": { "entityName": "Zone", "schema": { "$ref": "#/entities/Zone" } } },
      { "path": "/notifications/{notificationId}", "definition": { "entityName": "Notification", "schema": { "$ref": "#/entities/Notification" } } },
      { "path": "/appConfig", "definition": { "entityName": "AppConfig", "schema": { "$ref": "#/entities/AppConfig" } } }
    ]
  },
  "realtimeDb": {
    "description": "Mirror en RTDB para baja latencia (estado de lavadoras en uso + misiones activas).",
    "structure": [
      {
        "path": "/washerRentals/{rentalId}/live",
        "fields": ["status", "driverEta", "driverLoc", "lastUpdate"]
      },
      {
        "path": "/washerInventory/{unitId}/live",
        "fields": ["status", "currentLat", "currentLng", "lastUpdate"]
      },
      {
        "path": "/fleetMissions/{missionId}/live",
        "fields": ["status", "driverLoc", "eta", "lastUpdate"]
      }
    ]
  },
  "storage": {
    "buckets": [
      { "path": "/washer/{rentalId}/{fileName}", "visibility": "private", "ownerCheck": "rental.customerId == auth.uid" },
      { "path": "/washerInventory/{unitId}/{fileName}", "visibility": "public-read", "writer": "admin" },
      { "path": "/users/{uid}/{fileName}", "visibility": "owner-only" }
    ]
  },
  "indexes": {
    "note": "Para queries eficientes del módulo lavadoras se requieren los siguientes índices compuestos.",
    "composite": [
      { "collection": "washerRentals", "fields": ["status", "scheduledFor"], "order": "asc" },
      { "collection": "washerRentals", "fields": ["customerId", "status"], "order": "asc" },
      { "collection": "washerRentals", "fields": ["cityId", "zoneId", "status"], "order": "asc" },
      { "collection": "washerRentals", "fields": ["driverId", "status"], "order": "asc" },
      { "collection": "washerInventory", "fields": ["status", "cityId"], "order": "asc" },
      { "collection": "washerInventory", "fields": ["type", "status", "currentCityId"], "order": "asc" },
      { "collection": "fleetMissions", "fields": ["driverId", "status", "createdAt"], "order": "asc" },
      { "collection": "washerPricing", "fields": ["washerType", "hours", "cityId"], "order": "asc" },
      { "collection": "notifications", "fields": ["uid", "read", "createdAt"], "order": "desc" }
    ]
  }
}
