rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Vitriniando Security Rules - Producción
     * 
     * Estas reglas permiten el acceso público de lectura a tiendas y productos
     * para facilitar el descubrimiento, mientras restringen la edición 
     * exclusivamente a los propietarios autenticados.
     */

    // --- Funciones de Ayuda ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // --- Reglas de Colecciones ---

    /** Usuarios: Privados por defecto */
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update, delete: if isExistingOwner(userId) && isUnchanged('id');
    }

    /** 
     * Tiendas: 
     * Lectura: Pública si es 'active' o si es el dueño.
     * Escritura: Solo el dueño.
     */
    match /stores/{storeId} {
      allow get: if resource.data.status == 'active' || isOwner(resource.data.ownerId);
      allow list: if true; 
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.id == storeId;
      allow update: if isExistingOwner(resource.data.ownerId) && isUnchanged('ownerId') && isUnchanged('id');
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /** 
     * Productos (Raíz):
     * Permite que la página principal liste productos globales para descubrimiento.
     */
    match /products/{productId} {
      allow get: if resource.data.status == 'available' || isOwner(resource.data.storeOwnerId);
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.storeOwnerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.storeOwnerId) && isUnchanged('storeOwnerId');
      allow delete: if isExistingOwner(resource.data.storeOwnerId);
    }

    /** 
     * Categorías y Productos Anidados:
     * Mantiene la estructura jerárquica con herencia de permisos.
     */
    match /stores/{storeId}/categories/{categoryId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.storeOwnerId == request.auth.uid;
      allow update, delete: if isExistingOwner(resource.data.storeOwnerId);

      match /products/{productId} {
        allow get, list: if true;
        allow create: if isSignedIn() && request.resource.data.storeOwnerId == request.auth.uid;
        allow update, delete: if isExistingOwner(resource.data.storeOwnerId);
      }
    }
  }
}